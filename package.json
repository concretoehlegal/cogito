{
  "name": "cogito",
  "productName": "COGITO",
  "version": "0.15.0",
  "description": "COGITO: escreva livros de RPG, planeje campanhas num quadro livre e enfrente criaturas no Bestiário. Tudo offline, no Windows.",
  "author": "COGITO",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "assets": "node scripts/copy-pdfjs.cjs",
    "dev": "npm run assets && node scripts/dev.cjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run assets && tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "test": "node --test tests/*.test.ts",
    "dist:zip": "npm run build && electron-builder --win zip --x64 --publish never"
  },
  "build": {
    "appId": "app.cogito.desktop",
    "productName": "COGITO",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/dicionarios/*",
      "package.json"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "COGITO-${version}-windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "COGITO",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "COGITO-Instalador-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ]
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bree-serif": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-text-align": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "docx": "^9.15.4",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "immer": "^11.2.10",
    "lucide-react": "^1.73.0",
    "pdfjs-dist": "^4.10.38",
    "pe-library": "^2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resedit": "^3.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  }
}
